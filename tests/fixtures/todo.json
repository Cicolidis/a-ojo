  "pasos": [
    {
      "id": "p_00010",
      "receta_id": "r_brown",
      "orden": 1,
      "texto": "Precalentá el horno a 170 °C.",
      "timer_min": null,
      "tip": ""
    },
    {
      "id": "p_00011",
      "receta_id": "r_brown",
      "orden": 2,
      "texto": "Derretí el chocolate con la manteca a baño María, a fuego mínimo.",
      "timer_min": 5,
      "tip": ""
    },
    {
      "id": "p_00012",
      "receta_id": "r_brown",
      "orden": 3,
      "texto": "En otro bowl, batí el azúcar con los huevos hasta que se disuelvan los cristales.",
      "timer_min": null,
      "tip": "Es la clave para que el centro quede húmedo."
    },
    {
      "id": "p_00013",
      "receta_id": "r_brown",
      "orden": 4,
      "texto": "Sumá la vainilla, una pizca de sal y una de pimienta. Uní todo con el chocolate derretido.",
      "timer_min": null,
      "tip": "La pimienta realza el chocolate: no se siente picante."
    },
    {
      "id": "p_00014",
      "receta_id": "r_brown",
      "orden": 5,
      "texto": "Incorporá la harina tamizada y las nueces con movimientos envolventes.",
      "timer_min": null,
      "tip": ""
    },
    {
      "id": "p_00015",
      "receta_id": "r_brown",
      "orden": 6,
      "texto": "Volcá la mezcla en el molde enmantecado y horneá 23 minutos.",
      "timer_min": 23,
      "tip": "Tiene que salir con el centro todavía blando."
    },
    {
      "id": "p_00016",
      "receta_id": "r_brown",
      "orden": 7,
      "texto": "Dejá enfriar en el molde antes de cortar.",
      "timer_min": 30,
      "tip": ""
    },
    {
      "id": "p_00022",
      "receta_id": "r_vasca",
      "orden": 1,
      "texto": "Precalentá el horno a 220 °C y forrá el molde con papel manteca arrugado.",
      "timer_min": null,
      "tip": ""
    },
    {
      "id": "p_00023",
      "receta_id": "r_vasca",
      "orden": 2,
      "texto": "Batí el queso crema con el azúcar hasta que quede liso.",
      "timer_min": 3,
      "tip": ""
    },
    {
      "id": "p_00024",
      "receta_id": "r_vasca",
      "orden": 3,
      "texto": "Sumá los huevos de a uno, batiendo entre cada uno.",
      "timer_min": null,
      "tip": ""
    },
    {
      "id": "p_00025",
      "receta_id": "r_vasca",
      "orden": 4,
      "texto": "Agregá la crema de leche y la harina, y mezclá apenas.",
      "timer_min": null,
      "tip": ""
    },
    {
      "id": "p_00026",
      "receta_id": "r_vasca",
      "orden": 5,
      "texto": "Horneá 35 minutos: tiene que quedar bien dorada arriba y temblorosa en el centro.",
      "timer_min": 35,
      "tip": "El centro termina de cuajar mientras se enfría."
    },
    {
      "id": "p_00027",
      "receta_id": "r_vasca",
      "orden": 6,
      "texto": "Dejá enfriar y llevala a la heladera toda la noche.",
      "timer_min": null,
      "tip": ""
    },
    {
      "id": "p_00033",
      "receta_id": "r_galle",
      "orden": 1,
      "texto": "Precalentá el horno a 180 °C.",
      "timer_min": null,
      "tip": ""
    },
    {
      "id": "p_00034",
      "receta_id": "r_galle",
      "orden": 2,
      "texto": "Procesá los garbanzos con el aceite hasta que quede un puré.",
      "timer_min": null,
      "tip": ""
    },
    {
      "id": "p_00035",
      "receta_id": "r_galle",
      "orden": 3,
      "texto": "Sumá la harina de garbanzos, el comino y la sal, y formá una masa.",
      "timer_min": null,
      "tip": ""
    },
    {
      "id": "p_00036",
      "receta_id": "r_galle",
      "orden": 4,
      "texto": "Estirá la masa entre dos papeles y cortá las galletitas.",
      "timer_min": null,
      "tip": ""
    },
    {
      "id": "p_00037",
      "receta_id": "r_galle",
      "orden": 5,
      "texto": "Horneá 15 minutos, hasta que estén doradas.",
      "timer_min": 15,
      "tip": ""
    },
    {
      "id": "p_00042",
      "receta_id": "r_torti",
      "orden": 1,
      "texto": "Pisá la banana con un tenedor y mezclala con los huevos y la canela.",
      "timer_min": null,
      "tip": ""
    },
    {
      "id": "p_00043",
      "receta_id": "r_torti",
      "orden": 2,
      "texto": "Derretí la manteca en una sartén a fuego medio.",
      "timer_min": null,
      "tip": ""
    },
    {
      "id": "p_00044",
      "receta_id": "r_torti",
      "orden": 3,
      "texto": "Volcá la mezcla y cociná 2 minutos y medio de cada lado.",
      "timer_min": 2.5,
      "tip": ""
    },
    {
      "id": "p_00052",
      "receta_id": "r_pollo",
      "orden": 1,
      "texto": "Dorá los muslos de pollo del lado de la piel y reservalos.",
      "timer_min": 8,
      "tip": ""
    },
    {
      "id": "p_00053",
      "receta_id": "r_pollo",
      "orden": 2,
      "texto": "En la misma olla, rehogá las cebollas con el ajo y el comino.",
      "timer_min": 10,
      "tip": ""
    },
    {
      "id": "p_00054",
      "receta_id": "r_pollo",
      "orden": 3,
      "texto": "Volvé a poner el pollo, sumá el caldo y cociná tapado.",
      "timer_min": 35,
      "tip": ""
    },
    {
      "id": "p_00055",
      "receta_id": "r_pollo",
      "orden": 4,
      "texto": "Al final, agregá las aceitunas y el jugo de limón.",
      "timer_min": null,
      "tip": ""
    },
    {
      "id": "p_00061",
      "receta_id": "r_sopa",
      "orden": 1,
      "texto": "Rehogá la cebolla picada en una olla con un chorrito de aceite.",
      "timer_min": 5,
      "tip": ""
    },
    {
      "id": "p_00062",
      "receta_id": "r_sopa",
