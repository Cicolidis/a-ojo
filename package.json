{
  "name": "a-ojo",
  "version": "0.2.0",
  "private": true,
  "description": "App personal de recetas: captura, bandeja en Google Sheets, API de Apps Script y procesamiento con /recetas.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:py": "procesamiento/.venv/bin/python -m unittest discover -s procesamiento/tests",
    "clasp": "sh scripts/clasp.sh",
    "push": "sh scripts/clasp.sh push --force",
    "deploy": "sh scripts/deploy.sh",
    "smoke": "sh scripts/smoke.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1"
  }
}
