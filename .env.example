# Copiar como .env y completar. Nunca commitear el .env.

# Credenciales de clasp con nombre (clasp login --user <nombre>), para usar la
# cuenta de Gmail personal sin tocar la sesión por defecto de clasp.
# Vacío = usa la sesión por defecto.
A_OJO_CLASP_USER=personal

# URL del web app de Apps Script (termina en /exec)
A_OJO_API_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# URL de la app en GitHub Pages (para npm run link-config)
A_OJO_APP_URL=https://cicolidis.github.io/a-ojo/

# Token compartido (sale del log de setup() o de verToken())
A_OJO_TOKEN=

# ID del deployment del web app: npm run deploy siempre redeploya sobre este
A_OJO_DEPLOYMENT_ID=

# Cookies para procesar Instagram con la cuenta secundaria (ver docs/perfil-instagram.md).
# Navegador: chrome, brave, edge, chromium o firefox. Perfil: el nombre del perfil.
A_OJO_COOKIES_NAVEGADOR=chrome
A_OJO_COOKIES_PERFIL="A ojo – procesamiento"
# Opcional: dónde guarda «procesamiento/aojo fetch cookies» las cookies exportadas.
# A_OJO_COOKIES_ARCHIVO=~/.a-ojo/cookies-instagram.txt
